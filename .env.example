# Supabase sozlamalari — bu faylni ".env" nomi bilan nusxalab, qiymatlarni to'ldiring.
# Qiymatlarni Supabase loyihangizdan oling: Settings → API
# (anon key mijoz tomonida ochiq bo'lishi normal — u faqat public kalit)
VITE_SUPABASE_URL=https://XXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Web Push uchun VAPID ochiq kaliti (npx web-push generate-vapid-keys bilan yaratiladi)
# Maxfiy kalit mijozga QO'YILMAYDI — u faqat serverda (Edge Function).
VITE_VAPID_PUBLIC_KEY=BXXXX...
