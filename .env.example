# Supabase settings — copy this file to ".env" and fill in your values.
# Find values in your Supabase Dashboard: Settings -> API
# (anon key is safe on the client side as a public key)
VITE_SUPABASE_URL=https://XXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Web Push VAPID public key (generate via: npx web-push generate-vapid-keys)
# NEVER put the VAPID private key on the client — keep it in Edge Function secrets only.
VITE_VAPID_PUBLIC_KEY=BXXXX...
